#!/usr/bin/env bash
# impeccable: set up, check, and run the command-line tools the impeccable-python skill names.
#
#   impeccable doctor                    which tools run on this host, in the toolbox, or nowhere
#   impeccable setup toolbox [--rebuild] build the Linux toolbox image (needs Docker)
#   impeccable setup host [--dry-run]    install the pinned tools and interpreters on this host with uv
#   impeccable run [command...]          run a command in the toolbox, on the current project
#   impeccable sanitize <kind> [pytest args...]
#                                        pytest with the project's C/C++ extensions rebuilt under a
#                                        sanitizer: address, undefined, or address,undefined
#   impeccable valgrind [pytest args...]
#                                        pytest under Valgrind memcheck, with the uv-managed
#                                        interpreters' own false positives suppressed
#   impeccable fuzz <harness.py> [libFuzzer args...]
#                                        run an Atheris harness in the project environment
#   impeccable bench-guard <baseline> [--allow <check>=<reason>]... [--benches <pathspec>]... [-- command...]
#                                        check the benchmark contract against a baseline commit,
#                                        then run the command under a machine-wide benchmark lock
#
# sanitize, valgrind, and fuzz run on a Linux host that can run them, and in the toolbox otherwise.
#
# Environment:
#   IMPECCABLE_MOUNT=<dir>              mount this directory instead of the detected project root
#   IMPECCABLE_FUZZ_SECONDS=<n>         fuzz time limit when no -max_total_time or -runs is given (60)
#   IMPECCABLE_SANITIZE_PACKAGES="a b"  packages sanitize rebuilds from source (default: the project)
#   IMPECCABLE_BENCH_LOCK=<dir>         benchmark lock path (default ~/.cache/impeccable-bench/lock,
#                                       shared between host and toolbox benchmark runs)
#   UV_PYTHON=<version>                 interpreter for the project environment, for example 3.14t
set -euo pipefail

resolve_self_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd -P)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
  done
  cd "$(dirname "$src")" && pwd -P
}

SELF_DIR=$(resolve_self_dir)
SELF=$SELF_DIR/impeccable
SKILL_DIR=$(cd "$SELF_DIR/.." && pwd -P)
TOOLBOX_DIR=$SKILL_DIR/toolbox
IMAGE_REPO=impeccable-python-toolbox
SANITIZERS="address undefined"
PASS_ENV="CI UV_PYTHON UV_LOCKED UV_EXCLUDE_NEWER HYPOTHESIS_PROFILE PYTEST_ADDOPTS
  PYTHONDEVMODE PYTHONWARNINGS PYTHONMALLOC PYTHONHASHSEED PYTHONFAULTHANDLER
  PYTHONASYNCIODEBUG PYTHONTRACEMALLOC PYTHONWARNDEFAULTENCODING PYTHON_GIL COVERAGE_CORE
  IMPECCABLE_FUZZ_SECONDS IMPECCABLE_SANITIZE_PACKAGES
  ASAN_OPTIONS UBSAN_OPTIONS TSAN_OPTIONS LSAN_OPTIONS"

say() { printf 'impeccable: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
in_toolbox() { [ -n "${IMPECCABLE_IN_TOOLBOX:-}" ]; }
hash12() { { shasum -a 256 2>/dev/null || sha256sum; } | cut -c1-12; }
# verify_sha256 FILE SUMS: FILE's hash must equal its entry in SUMS. One hasher is chosen up front;
# a "shasum -c || sha256sum -c" fallback passes on macOS, where BSD sha256sum accepts empty input.
verify_sha256() {
  local want got
  want=$(awk -v f="$1" '$2 == f || $2 == "*" f { print $1; exit }' "$2")
  if have sha256sum; then got=$(sha256sum "$1"); else got=$(shasum -a 256 "$1"); fi
  got=${got%% *}
  [ -n "$want" ] && [ "$want" = "$got" ] || die "checksum mismatch for $1 (want ${want:-no entry in $2}, got $got)"
}
first_version() { grep -E -o '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1; }

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF"
}

toolbox_file() {
  local f
  for f in "$TOOLBOX_DIR/$1" "/usr/local/share/impeccable/$1"; do
    if [ -f "$f" ]; then echo "$f"; return 0; fi
  done
  return 1
}

# Prints "name version kind [command]" for every pinned tool.
tools() {
  local f
  f=$(toolbox_file tools.txt) || die "tools.txt not found next to $SELF"
  grep -v -E '^[[:space:]]*(#|$)' "$f"
}

# A pin from the Dockerfile, for example `pin TLA_VERSION`. Empty inside the toolbox.
pin() {
  local f
  f=$(toolbox_file Dockerfile) || return 0
  sed -n "s/^ARG $1=//p" "$f" | tr -d '"'
}

# True when dotted version $1 is older than $2.
ver_lt() {
  local IFS=. i x y
  local -a a b
  read -r -a a <<<"$1"
  read -r -a b <<<"$2"
  for i in 0 1 2; do
    x=${a[i]:-0}
    y=${b[i]:-0}
    if [ "$((10#$x))" -lt "$((10#$y))" ]; then return 0; fi
    if [ "$((10#$x))" -gt "$((10#$y))" ]; then return 1; fi
  done
  return 1
}

version_cell() { # found pinned
  if [ -z "$1" ]; then echo missing
  elif ver_lt "$1" "$2"; then echo "$1, older than pinned"
  else echo "$1"; fi
}

# Version of a uv tool (or anything on PATH that prints one with --version).
UV_TOOLS=""
host_tool_version() { # name command
  local v=""
  if [ -z "$UV_TOOLS" ] && have uv; then UV_TOOLS=$(uv tool list 2>/dev/null || echo none); fi
  v=$(printf '%s\n' "$UV_TOOLS" | awk -v n="$1" '$1 == n { sub(/^v/, "", $2); print $2; exit }')
  if [ -z "$v" ] && have "$2"; then v=$("$2" --version 2>/dev/null | first_version || true); fi
  echo "$v"
}

# A usable Linux host for native checks: sanitize needs gcc, fuzz needs an Atheris wheel.
linux_host() { [ "$(uname -s)" = Linux ]; }
atheris_wheel_exists() { linux_host && [ "$(uname -m)" = x86_64 ]; }

toolbox_image() {
  [ -f "$TOOLBOX_DIR/Dockerfile" ] || die "toolbox files not found in $TOOLBOX_DIR"
  printf '%s:%s' "$IMAGE_REPO" \
    "$(cat "$TOOLBOX_DIR/Dockerfile" "$TOOLBOX_DIR/tools.txt" "$TOOLBOX_DIR/entrypoint" \
      "$TOOLBOX_DIR/valgrind-python.supp" "$SELF" | hash12)"
}

docker_ready() { have docker && docker info >/dev/null 2>&1; }
image_built() { docker image inspect "$1" >/dev/null 2>&1; }

# The directory holding uv.lock (the workspace root), else the git root, else the current directory.
project_root() {
  local dir root=""
  if [ -n "${IMPECCABLE_MOUNT:-}" ]; then
    (cd "$IMPECCABLE_MOUNT" && pwd -P)
    return 0
  fi
  dir=$(pwd -P)
  while [ "$dir" != / ]; do
    if [ -f "$dir/uv.lock" ]; then root=$dir; break; fi
    dir=$(dirname "$dir")
  done
  if [ -z "$root" ]; then root=$(git rev-parse --show-toplevel 2>/dev/null || true); fi
  if [ -z "$root" ]; then root=$PWD; fi
  (cd "$root" && pwd -P)
}

project_env() { echo "${UV_PROJECT_ENVIRONMENT:-$(project_root)/.venv}"; }

cmd_doctor() {
  local image="" built="" state name ver kind cmd v host tb py want minor found
  if in_toolbox; then
    state="inside the toolbox"
    built=1
  elif ! have docker; then
    state="not installed"
  elif ! docker info >/dev/null 2>&1; then
    state="installed, not running"
  else
    image=$(toolbox_image)
    if image_built "$image"; then
      state="ready, $image built"
      built=1
    else
      state="ready, image not built: impeccable setup toolbox"
    fi
  fi

  printf 'impeccable doctor on %s %s\n\n' "$(uname -s)" "$(uname -m)"
  row() { printf '  %-22s %-37s %s\n' "$1" "$2" "$3"; }
  row TOOL HOST TOOLBOX

  v=""
  if have uv; then v=$(uv --version 2>/dev/null | first_version || true); fi
  if [ -z "$v" ]; then host="missing: https://docs.astral.sh/uv/"; else host=$(version_cell "$v" "$(pin UV_VERSION)"); fi
  row uv "$host" "$(pin UV_VERSION)"

  # One row per minor version; the free-threaded build is its own row (3.14t).
  for py in $(pin PYTHONS); do
    want=${py%t}
    minor=${want%.*}${py#"$want"}
    found=""
    if have uv; then found=$(uv python find "$minor" 2>/dev/null || true); fi
    v=""
    if [ -n "$found" ]; then
      v=$("$found" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)
    fi
    row "python $minor" "$(version_cell "$v" "$want")" "$py"
  done

  while read -r name ver kind cmd; do
    [ "$kind" = tool ] || continue
    v=$(host_tool_version "$name" "${cmd:-$name}")
    row "$name" "$(version_cell "$v" "$ver")" "$ver"
  done < <(tools)

  v=""
  if have osv-scanner; then v=$(osv-scanner --version 2>/dev/null | first_version || true); fi
  row osv-scanner "$(version_cell "$v" "$(pin OSV_SCANNER_VERSION)")" "$(pin OSV_SCANNER_VERSION)"

  v=""
  if have actionlint; then v=$(actionlint --version 2>/dev/null | first_version || true); fi
  row actionlint "$(version_cell "$v" "$(pin ACTIONLINT_VERSION)")" "$(pin ACTIONLINT_VERSION)"

  if in_toolbox; then host="built from source"
  elif atheris_wheel_exists; then host="PyPI wheel via impeccable fuzz"
  else host="no wheel for $(uname -s) $(uname -m)"; fi
  row atheris "$host" "$(pin ATHERIS_VERSION)"

  if have valgrind; then host=$(valgrind --version 2>/dev/null | first_version || true)
  elif [ "$(uname -s)" = Darwin ]; then host="unsupported on macOS"
  else host=missing; fi
  row valgrind "$host" yes

  if have tlc; then host=installed
  elif have java && java -version >/dev/null 2>&1; then host="java only: add a tlc wrapper"
  else host=missing; fi
  row "tlc (TLA+)" "$host" "$(pin TLA_VERSION)"

  for kind in $SANITIZERS; do
    if linux_host && have gcc; then host=supported
    elif linux_host; then host="needs gcc"
    else host="runs in the toolbox"; fi
    row "sanitize $kind" "$host" supported
  done

  local env pyexe names
  env=$(project_env)
  pyexe=$env/bin/python
  printf '\n  Project dev dependencies in %s (add with: uv add --dev "name==version")\n\n' "$env"
  row TOOL PROJECT PINNED
  names=$(tools | awk '$3 == "dev" { print $1 }' | tr '\n' ' ')
  if [ -x "$pyexe" ]; then
    # One interpreter start for every lookup.
    # shellcheck disable=SC2086
    "$pyexe" - $names <<'EOF' >"${TMPDIR:-/tmp}/impeccable-doctor.$$" 2>/dev/null || true
import sys
from importlib import metadata
for name in sys.argv[1:]:
    try:
        print(name, metadata.version(name))
    except metadata.PackageNotFoundError:
        print(name, "")
EOF
  fi
  while read -r name ver kind _cmd; do
    [ "$kind" = dev ] || continue
    if [ ! -x "$pyexe" ]; then v=""
    else v=$(awk -v n="$name" '$1 == n { print $2; exit }' "${TMPDIR:-/tmp}/impeccable-doctor.$$" 2>/dev/null || true); fi
    if [ ! -x "$pyexe" ]; then tb="no environment: uv sync"
    else tb=$(version_cell "$v" "$ver"); fi
    if [ "$tb" = missing ]; then tb="not in the project"; fi
    row "$name" "$tb" "$ver"
  done < <(tools)
  rm -f "${TMPDIR:-/tmp}/impeccable-doctor.$$"

  printf '\n  docker: %s\n' "$state"
  if [ -z "$built" ] && ! in_toolbox; then
    printf '  The toolbox column applies once the image is built.\n'
  fi
  printf '  Run a tool the host lacks with: impeccable run <command>\n'
}

cmd_setup() {
  local what=${1:-}
  if [ $# -gt 0 ]; then shift; fi
  case $what in
    toolbox) setup_toolbox "$@" ;;
    host) setup_host "$@" ;;
    *) die "usage: impeccable setup toolbox [--rebuild] | impeccable setup host [--dry-run]" ;;
  esac
}

setup_toolbox() {
  local image
  if in_toolbox; then die "already inside the toolbox"; fi
  docker_ready || die "Docker is not running. Start it, or install the tools here with: impeccable setup host"
  image=$(toolbox_image)
  if [ "${1:-}" != --rebuild ] && image_built "$image"; then
    say "toolbox image $image is up to date"
    return 0
  fi
  say "building $image; the first build downloads a few GB and takes several minutes"
  DOCKER_BUILDKIT=1 docker build -t "$image" -t "$IMAGE_REPO:latest" \
    -f "$TOOLBOX_DIR/Dockerfile" "$SKILL_DIR" >&2
  say "built $image"
  local old
  docker image ls "$IMAGE_REPO" --format '{{.Tag}}' | while read -r old; do
    case $old in latest | "${image#*:}") ;; *)
      say "removing superseded image $IMAGE_REPO:$old"
      docker image rm "$IMAGE_REPO:$old" >/dev/null || true ;;
    esac
  done
}

setup_host() {
  local dry="" name ver kind _cmd v os arch osv al bin tmp
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  have uv || die "uv is required: https://docs.astral.sh/uv/"
  step() { if [ -n "$dry" ]; then printf '  %s\n' "$*"; else "$@"; fi; }

  v=$(uv --version | first_version)
  if ver_lt "$v" "$(pin UV_VERSION)"; then
    say "uv $v is older than the pinned $(pin UV_VERSION); update it the way you installed it (for example: uv self update $(pin UV_VERSION))"
  fi

  # --no-bin keeps versioned python shims off PATH; uv run --python <version> finds them.
  # shellcheck disable=SC2046
  step uv python install --no-bin $(pin PYTHONS)

  while read -r name ver kind _cmd; do
    [ "$kind" = tool ] || continue
    step uv tool install --exclude-newer "$(pin EXCLUDE_NEWER)" "$name==$ver"
  done < <(tools)

  # osv-scanner is a Go binary: download the release asset and check it against the release checksums.
  osv=$(pin OSV_SCANNER_VERSION)
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case $(uname -m) in x86_64 | amd64) arch=amd64 ;; arm64 | aarch64) arch=arm64 ;; *) arch=$(uname -m) ;; esac
  bin=${UV_TOOL_BIN_DIR:-$HOME/.local/bin}
  if [ -n "$dry" ]; then
    printf '  download osv-scanner_%s_%s v%s, verify osv-scanner_SHA256SUMS, install to %s\n' "$os" "$arch" "$osv" "$bin"
  else
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/impeccable-osv.XXXXXX")
    (
      cd "$tmp"
      base="https://github.com/google/osv-scanner/releases/download/v$osv"
      curl -fsSLO "$base/osv-scanner_${os}_${arch}"
      curl -fsSLO "$base/osv-scanner_SHA256SUMS"
      verify_sha256 "osv-scanner_${os}_${arch}" osv-scanner_SHA256SUMS
      mkdir -p "$bin"
      install -m 0755 "osv-scanner_${os}_${arch}" "$bin/osv-scanner"
    )
    rm -f "$tmp/osv-scanner_${os}_${arch}" "$tmp/osv-scanner_SHA256SUMS"
    rmdir "$tmp"
  fi

  # actionlint is a Go binary too, released as a tarball with a checksums file.
  al=$(pin ACTIONLINT_VERSION)
  if [ -n "$dry" ]; then
    printf '  download actionlint_%s_%s_%s.tar.gz, verify its checksum, install to %s\n' "$al" "$os" "$arch" "$bin"
  else
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/impeccable-actionlint.XXXXXX")
    (
      cd "$tmp"
      tgz="actionlint_${al}_${os}_${arch}.tar.gz"
      base="https://github.com/rhysd/actionlint/releases/download/v$al"
      curl -fsSLO "$base/$tgz"
      curl -fsSLO "$base/actionlint_${al}_checksums.txt"
      verify_sha256 "$tgz" "actionlint_${al}_checksums.txt"
      tar -xzf "$tgz" actionlint
      mkdir -p "$bin"
      install -m 0755 actionlint "$bin/actionlint"
      rm -f "$tgz" "actionlint_${al}_checksums.txt" actionlint
    )
    rmdir "$tmp"
  fi

  say "project-side tools come from the project's lock, not from here: uv add --dev \"name==version\" (see impeccable doctor)"
  if ! linux_host; then say "valgrind, sanitize, and fuzz run in the toolbox on this host: impeccable setup toolbox"; fi
}

cmd_run() {
  local image root cur rel key var
  local -a args
  if [ $# -eq 0 ]; then set -- bash; fi
  if in_toolbox; then exec "$@"; fi
  docker_ready || die "Docker is not running. Start it, or install the tools here with: impeccable setup host"
  image=$(toolbox_image)
  image_built "$image" || setup_toolbox

  root=$(project_root)
  cur=$(pwd -P)
  case $cur in
    "$root") rel="" ;;
    "$root"/*) rel=${cur#"$root"/} ;;
    *) root=$cur; rel="" ;;
  esac
  key=$(printf '%s' "$root" | hash12)

  args=(run --rm --init
    -v "$root:/work" -w "/work${rel:+/$rel}"
    -v "impeccable-python-venvs-$key:/venvs"
    -v impeccable-python-cache:/cache)
  if [ -t 0 ]; then args+=(-i); fi
  if [ -t 1 ]; then args+=(-t); fi
  for var in $PASS_ENV; do
    if [ -n "${!var:-}" ]; then args+=(-e "$var"); fi
  done
  # Bind-mount the benchmark lock directory so host and toolbox runs, and
  # concurrent toolbox runs, share the same lock instead of competing.
  bench=${IMPECCABLE_BENCH_LOCK:-$(bench_lock_dir)/lock}
  mkdir -p "$(dirname "$bench")"
  args+=(-v "$(dirname "$bench"):$(dirname "$bench")" -e "IMPECCABLE_BENCH_LOCK=$bench")
  exec docker "${args[@]}" "$image" "$@"
}

# The [project] name in pyproject.toml.
project_name() {
  awk '/^\[/ { in_project = ($0 == "[project]") }
       in_project && /^name[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); gsub(/["'\'']/, ""); print; exit }' \
    "$(project_root)/pyproject.toml" 2>/dev/null
}

cmd_sanitize() {
  local kind=${1:-} part flags env pkg tmp cache so symbols found
  local -a pkgs=() reinstall=() preload=()
  [ -n "$kind" ] || die "usage: impeccable sanitize <address|undefined|address,undefined> [pytest args]"
  shift
  for part in ${kind//,/ }; do
    case " $SANITIZERS " in *" $part "*) ;; *) die "unknown sanitizer: $part" ;; esac
  done
  if ! linux_host || ! have gcc; then
    if in_toolbox; then die "sanitize needs gcc on Linux"; fi
    say "sanitize runs on Linux with gcc; running it in the toolbox"
    cmd_run impeccable sanitize "$kind" "$@"
  fi
  have uv || die "uv is required"
  [ -f "$(project_root)/pyproject.toml" ] || die "no pyproject.toml at $(project_root)"

  # Instrument the extensions, not the interpreter: an unmodified CPython works with the
  # ASan runtime preloaded. Build into a separate environment so .venv stays uninstrumented,
  # and install non-editable; the instrumented build tree is removed after the sync.
  flags="-fsanitize=$kind -fno-sanitize-recover=all -fno-omit-frame-pointer -g"
  export CC=gcc CXX=g++ LDSHARED="gcc -shared" LDCXXSHARED="g++ -shared"
  export CFLAGS="${CFLAGS:+$CFLAGS }$flags"
  export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }$flags"
  export LDFLAGS="${LDFLAGS:+$LDFLAGS }-fsanitize=$kind"
  env=$(project_env)
  export UV_PROJECT_ENVIRONMENT="$env-sanitize-${kind//,/-}"

  # --reinstall-package alone puts a cached PyPI wheel back; --no-binary-package builds from
  # source. uv caches source builds whatever the flags, so each sanitizer gets its own cache:
  # no instrumented wheel reaches the shared cache, and no other kind's build is reused.
  cache=$(uv cache dir)
  export UV_CACHE_DIR="$cache-sanitize-${kind//,/-}"
  for pkg in ${IMPECCABLE_SANITIZE_PACKAGES:-$(project_name)}; do
    pkgs+=("$pkg")
    reinstall+=(--reinstall-package "$pkg" --no-binary-package "$pkg")
  done
  [ ${#pkgs[@]} -gt 0 ] || die "cannot read the project name; set IMPECCABLE_SANITIZE_PACKAGES"
  # setuptools reuses object files left in build/ by an earlier run with other flags, so
  # force the rebuild, in a directory normal builds never use. The relative build_base
  # resolves inside each package's source tree, so packages built at once never share one.
  # Other backends build in a fresh directory.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/impeccable-sanitize.XXXXXX")
  printf '[build]\nbuild_base = build/impeccable-sanitize-%s\n\n[build_ext]\nforce = 1\n' "${kind//,/-}" >"$tmp/setup.cfg"
  say "rebuilding ${pkgs[*]} from source with $flags into $UV_PROJECT_ENVIRONMENT"
  DIST_EXTRA_CONFIG=$tmp/setup.cfg uv sync --locked --no-editable "${reinstall[@]}"
  rm -r -- "$tmp"
  # Only the directory named in setup.cfg above; nothing else under build/.
  build_dir="$(project_root)/build/impeccable-sanitize-${kind//,/-}"
  if [ -d "$build_dir" ]; then rm -r -- "$build_dir"; fi
  rmdir "$(project_root)/build" 2>/dev/null || true

  # An uninstrumented run reports clean, so fail unless each rebuilt package ships an
  # extension that links the sanitizer runtime.
  symbols="__(${kind//,/|})_"
  symbols=${symbols//address/asan}
  symbols=${symbols//undefined/ubsan}
  for pkg in "${pkgs[@]}"; do
    found=""
    while IFS= read -r so; do
      # Not a pipe: grep -q exits at the first match, nm dies of SIGPIPE, and pipefail
      # turns an instrumented extension into a miss.
      syms=$(nm -D "$so" 2>/dev/null || true)
      if grep -q -E "$symbols" <<<"$syms"; then found=$so; break; fi
    done < <(uv run --no-sync python - "$pkg" <<'EOF'
import sys
from importlib import metadata
for f in metadata.files(sys.argv[1]) or ():
    if f.name.endswith(".so"):
        print(f.locate())
EOF
    )
    [ -n "$found" ] || die "$pkg has no extension built with -fsanitize=$kind; nothing native would be checked"
    say "instrumented: $found"
  done

  # CPython leaks at exit by design, so leak detection stays off unless ASAN_OPTIONS says
  # otherwise. pymalloc hides overflows inside its own blocks, so use libc malloc, which
  # free-threaded builds do not offer.
  case ",$kind," in *,address,*) preload=("LD_PRELOAD=$(gcc -print-file-name=libasan.so)") ;; esac
  export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"
  export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"
  case ${UV_PYTHON:-} in
    *t) say "free-threaded CPython has no PYTHONMALLOC=malloc; overflows inside Python allocator blocks can go unseen" ;;
    *) export PYTHONMALLOC="${PYTHONMALLOC:-malloc}" ;;
  esac
  # pytest's default fd capture discards a sanitizer report when the process aborts, so
  # capture at the sys level unless the caller chose. The pytest entry point, not
  # `python -m pytest`, keeps the working directory off sys.path, ahead of the
  # installed, instrumented package.
  case " $* " in *" -s "* | *" --capture"*) ;; *) set -- --capture=sys "$@" ;; esac
  say "${preload[*]+${preload[*]} }pytest $*"
  exec uv run --no-sync env ${preload[@]+"${preload[@]}"} pytest "$@"
}

cmd_valgrind() {
  local supp
  if ! linux_host || ! have valgrind; then
    if in_toolbox; then die "valgrind is missing"; fi
    say "valgrind is not on this host; running it in the toolbox"
    cmd_run impeccable valgrind "$@"
  fi
  have uv || die "uv is required"
  case ${UV_PYTHON:-} in
    *t) die "free-threaded CPython has no PYTHONMALLOC=malloc, and Valgrind cannot see inside its allocator; use a GIL build" ;;
  esac
  supp=$(toolbox_file valgrind-python.supp) || die "valgrind-python.supp not found next to $SELF"
  # pymalloc hides small blocks from Valgrind, so use libc malloc. The uv-managed
  # interpreters report uninitialised values in their own code; the suppressions drop those
  # and keep invalid reads, writes, and frees. CPython leaks at exit, so leaks do not fail.
  export PYTHONMALLOC=malloc
  say "PYTHONMALLOC=malloc valgrind --error-exitcode=9 --suppressions=$supp python -m pytest $*"
  exec uv run --locked valgrind --error-exitcode=9 --suppressions="$supp" python -m pytest "$@"
}

cmd_fuzz() {
  local harness=${1:-} arg limit=1
  local -a with
  [ -n "$harness" ] || die "usage: impeccable fuzz <harness.py> [libFuzzer args]"
  shift
  [ -f "$harness" ] || die "no such harness: $harness"
  if ! in_toolbox && ! atheris_wheel_exists; then
    say "Atheris ships wheels only for Linux x86_64; running the harness in the toolbox"
    cmd_run impeccable fuzz "$harness" "$@"
  fi
  have uv || die "uv is required"
  # libFuzzer runs until it finds a crash; give every run a limit unless one is set.
  for arg in "$@"; do
    case $arg in -max_total_time=* | -runs=* | -atheris_runs=*) limit="" ;; esac
  done
  if [ -n "$limit" ]; then set -- "-max_total_time=${IMPECCABLE_FUZZ_SECONDS:-60}" "$@"; fi
  with=(--with "atheris==$(pin ATHERIS_VERSION)")
  if [ -n "${IMPECCABLE_WHEELS:-}" ]; then with=(--find-links "$IMPECCABLE_WHEELS" "${with[@]}"); fi
  say "python $harness $*"
  exec uv run --locked "${with[@]}" python "$harness" "$@"
}

# A pyproject.toml minus its dependency tables: the build system, tool
# configuration (pytest addopts can inject flags and disable plugins,
# coverage can change what runs), and metadata baked into artifacts.
# Dependency changes are reported by the deps note instead, so a legitimately
# added package is a documented change rather than a failed contract check.
non_dependency_tables() {
  awk 'BEGIN { keep = 1 }
    /^[[:space:]]*\[/ {
      keep = !($0 ~ /^[[:space:]]*\[(project|dependency-groups)\]/ ||
               $0 ~ /^[[:space:]]*\[project\.(dependencies|optional-dependencies)/ ||
               $0 ~ /^[[:space:]]*\[tool\.uv\]/)
    }
    keep'
}

# The requires-python setting of a pyproject.toml read from stdin: it selects
# the interpreter, so it belongs to the build check even though [project] is
# otherwise a dependency table.
requires_python() {
  awk 'BEGIN { p = 0 }
    /^[[:space:]]*\[/ { p = ($0 ~ /^[[:space:]]*\[project\]/) }
    p && /^[[:space:]]*requires-python[[:space:]]*=/'
}

# The dependency tables of a pyproject.toml read from stdin: [project] (name,
# version, requires-python aside, which requires_python covers for the build
# check), [project.dependencies*], [dependency-groups], and [tool.uv].
dependency_tables() {
  awk 'BEGIN { keep = 0 }
    /^[[:space:]]*\[/ {
      keep = ($0 ~ /^[[:space:]]*\[(project|dependency-groups)\]/) ||
             ($0 ~ /^[[:space:]]*\[project\.(dependencies|optional-dependencies)/) ||
             ($0 ~ /^[[:space:]]*\[tool\.uv\]/)
    }
    keep'
}

# Environment variables that change interpreter or runtime behavior and do not ship to users.
bench_runtime_env() {
  env | sed -n -E 's/^(PYTHONOPTIMIZE|PYTHONDEVMODE|PYTHONMALLOC|PYTHON_JIT|PYTHON_GIL|PYTHONASYNCIODEBUG|PYTHONTRACEMALLOC|PYTHONWARNDEFAULTENCODING|PYTHONPROFILEIMPORTTIME|PYTHONPATH|COVERAGE_CORE|PYTEST_ADDOPTS|UV_PYTHON)=.*/\1/p'
}

# An interpreter fingerprint: implementation, version, free-threading, platform.
interp_fingerprint() {
  "$1" - <<'EOF' 2>/dev/null
import platform, sys
gil = getattr(sys, "_is_gil_enabled", None)
print(sys.implementation.name, platform.python_version(),
      "gil=" + ("on" if gil() else "off") if callable(gil) else "gil=n/a",
      platform.machine(), platform.system().lower())
EOF
}

# The benchmark lock lives outside /tmp so cmd_run can bind-mount the same
# directory into the toolbox: host runs and toolbox runs then compete for one
# lock instead of each sandbox holding its own.
bench_lock_dir() {
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/impeccable-bench"
}

bench_lock_path() {
  echo "${IMPECCABLE_BENCH_LOCK:-$(bench_lock_dir)/lock}"
}

# Takes the lock directory $1, waiting for a live holder and clearing a dead
# same-host one. A holder from another host (for example inside the toolbox,
# which has its own hostname and pid namespace) cannot be reaped by pid, so
# the wait is bounded and then the run dies rather than compete.
acquire_bench_lock() {
  local lock=$1 holder host pid waited=""
  while ! mkdir "$lock" 2>/dev/null; do
    holder=$(cat "$lock/pid" 2>/dev/null || true)
    host=${holder%% *}; pid=${holder##* }
    if [ "$host" = "$(hostname)" ] && [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      say "clearing a benchmark lock left by process $pid, which has exited"
      rm -rf "$lock"
      continue
    fi
    if [ -z "$waited" ]; then
      say "another benchmark is running${holder:+ (process $holder)}; waiting so the runs do not compete"
      waited=$(date +%s)
    elif [ $(( $(date +%s) - waited )) -gt 600 ]; then
      die "the benchmark lock at $lock has been held over 10 minutes (holder: ${holder:-unknown}); if the holder is dead, remove it: rm -rf $lock"
    fi
    sleep 2
  done
  echo "$(hostname) $$" >"$lock/pid"
}

cmd_bench_guard() {
  local base="" top short files old new n fails=0 a lock
  local -a cmd=() allows=() specs=()
  local checks="benches build runtime command"
  local usage_line="usage: impeccable bench-guard <baseline> [--allow <check>=<reason>]... [--benches <pathspec>]... [-- command...]"
  while [ $# -gt 0 ]; do
    case $1 in
      --allow) [ $# -ge 2 ] || die "$usage_line"; allows+=("$2"); shift ;;
      --allow=*) allows+=("${1#--allow=}") ;;
      --benches) [ $# -ge 2 ] || die "$usage_line"; specs+=("$2"); shift ;;
      --benches=*) specs+=("${1#--benches=}") ;;
      --) shift; cmd=("$@"); break ;;
      -h | --help) say "$usage_line"; return 0 ;;
      -*) die "unknown option: $1" ;;
      *) if [ -z "$base" ]; then base=$1; else die "$usage_line"; fi ;;
    esac
    shift
  done
  [ -n "$base" ] || die "$usage_line"
  for a in ${allows[@]+"${allows[@]}"}; do
    case " $checks " in *" ${a%%=*} "*) ;; *) die "--allow takes one of: $checks (got '${a%%=*}')" ;; esac
    case $a in *=?*) ;; *) die "--allow ${a%%=*} needs a reason: --allow ${a%%=*}=<why>" ;; esac
  done

  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "bench-guard needs a git repository"
  git -C "$top" rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "not a commit: $base"
  short=$(git -C "$top" log -1 --format='%h %s' "$base")

  row() { printf '  %-7s %-8s %s\n' "$1" "$2" "$3"; }
  waiver() {
    local x
    for x in ${allows[@]+"${allows[@]}"}; do
      if [ "${x%%=*}" = "$1" ]; then echo "${x#*=}"; return 0; fi
    done
    return 1
  }
  verdict() { # check pass|fail|note detail
    local why
    case $2 in
      pass) row PASS "$1" "$3" ;;
      note) row NOTE "$1" "$3" ;;
      *) if why=$(waiver "$1"); then row WAIVED "$1" "$3; reason: $why"
         else row FAIL "$1" "$3"; fails=$((fails + 1)); fi ;;
    esac
  }
  changed() { # pathspec...
    { git -C "$top" diff --name-only "$base" -- "$@"; git -C "$top" ls-files --others --exclude-standard -- "$@"; } | sort -u
  }
  listed() { # newline-separated items, at most six shown
    n=$(printf '%s\n' "$1" | wc -l | tr -d ' ')
    printf '%s\n' "$1" | head -6 | paste -sd ' ' -
    if [ "$n" -gt 6 ]; then printf ' and %s more' "$((n - 6))"; fi
  }

  printf 'impeccable bench-guard against %s\n\n' "$short"

  # benches: the benchmark definitions and their fixtures are the contract.
  # --benches adds more files to it (an oracle module, a workload fixture).
  # pytest-benchmark's saved results dir (.benchmarks/) is output, not contract.
  specs=(':(glob)**/benches/**' ':(glob)**/benchmarks/**' ':(glob)**/conftest.py' \
    ':(glob)**/bench_*.py' ':(glob)**/*_bench*.py' ':(glob)**/test_bench*.py' ':(glob)**/benchmark*.py' "${specs[@]+"${specs[@]}"}")
  files=$(changed "${specs[@]}" | grep -v -E '(^|/)\.benchmarks/' || true)
  if [ -z "$files" ]; then verdict benches pass "benchmark files match the baseline"
  else verdict benches fail "benchmark files differ from the baseline: $(listed "$files")"; fi

  # build: build configuration, tool settings, and interpreter selection are
  # the contract. A pyproject.toml outside the dependency tables counts — its
  # [tool.*] sections can inject pytest flags or change what runs — while
  # dependency churn is reported by the deps note, not failed here.
  files=$(changed ':(glob)**/setup.py' ':(glob)**/setup.cfg' ':(glob)**/MANIFEST.in' \
    ':(glob)**/.python-version' ':(glob)**/meson.build' ':(glob)**/pybind11/**' ':(glob)**/Cargo.toml')
  for f in $(changed ':(glob)**/pyproject.toml'); do
    old_file=$(git -C "$top" show "$base:$f" 2>/dev/null || true)
    old=$(printf '%s\n' "$old_file" | non_dependency_tables; printf '%s\n' "$old_file" | requires_python)
    new=$(non_dependency_tables <"$top/$f"; requires_python <"$top/$f")
    if [ "$old" != "$new" ]; then files=$(printf '%s\n%s' "$files" "$f [tool/build/requires-python]" | sed '/^$/d'); fi
  done
  if [ -z "$files" ]; then verdict build pass "build and tool configuration and interpreter selection match the baseline"
  else verdict build fail "build or tool configuration differs from the baseline: $(listed "$files")"; fi

  # runtime: environment that changes interpreter behavior does not ship.
  files=$(bench_runtime_env)
  if [ -z "$files" ]; then verdict runtime pass "no benchmark-affecting environment variables"
  else verdict runtime fail "runtime environment that does not ship: $(listed "$files")"; fi

  # command: the run must not change semantics or the machine. -O strips
  # asserts and docstrings; an interpreter flag or a versioned interpreter
  # binary selects a different machine than the baseline's files pinned.
  if [ ${#cmd[@]} -gt 0 ]; then
    local bad="" bad_interp="" seen_pytest=""
    for a in "${cmd[@]}"; do
      case $a in
        -O | -OO | --optimize*) bad=$a ;;
        --python | --python=* | --python-version | --python-version=*) bad_interp=$a ;;
        -X | -X*) bad_interp=$a ;;
        --benchmark-disable) seen_pytest=disabled ;;
      esac
      case ${a##*/} in
        pytest | py.test) seen_pytest=yes ;;
        python3.[0-9]* | pypy*) bad_interp=$a ;;
      esac
    done
    if [ -n "$bad" ]; then verdict command fail "command passes $bad, which strips asserts and docstrings"
    elif [ -n "$bad_interp" ]; then verdict command fail "command selects an interpreter ($bad_interp); interpreter selection is part of the contract"
    elif [ "$seen_pytest" = disabled ]; then verdict command fail "command disables benchmarks (--benchmark-disable)"
    elif [ "$seen_pytest" = yes ]; then verdict command pass "benchmark command runs pytest"
    else verdict command note "not a pytest command; confirm it measures the optimized path" ; fi
  fi

  # Notes route risk to its owner; they never fail the run.
  files=$(changed ':(glob)**/uv.lock' ':(glob)**/requirements*.txt' ':(glob)**/requirements*.in' ':(glob)**/poetry.lock' ':(glob)**/Pipfile.lock')
  for f in $(changed ':(glob)**/pyproject.toml'); do
    old=$(git -C "$top" show "$base:$f" 2>/dev/null | dependency_tables || true)
    new=$(dependency_tables <"$top/$f")
    if [ "$old" != "$new" ]; then files=$(printf '%s\n%s' "$files" "$f [deps]" | sed '/^$/d'); fi
  done
  files=$(printf '%s\n' "$files" | sed '/^$/d' | sort -u)
  if [ -n "$files" ]; then
    row NOTE deps "dependencies added or changed; declare them and run the dependency checks: $(listed "$files")"
  fi

  if [ -n "${PYTHONHASHSEED:-}" ]; then
    row NOTE seed "PYTHONHASHSEED=$PYTHONHASHSEED pins hash order; confirm the baseline used the same value"
  else
    row NOTE seed "PYTHONHASHSEED is unset: hash randomization reorders sets and dicts run to run, so order-dependent workloads differ between identical commands — pin it on both sides when the workload is order-dependent"
  fi

  local py
  for py in "$(project_env)/bin/python" python3 python; do
    if [ -x "${py%% *}" ] || have "${py%% *}"; then
      a=$(interp_fingerprint "$py")
      [ -n "$a" ] && { row NOTE interp "measuring interpreter: $a (via $py)"; break; }
    fi
  done
  row NOTE interp "the same implementation, exact version, and free-threaded mode must run both sides; the guard cannot prove the baseline's interpreter — record it in the run log"

  if [ "$fails" -gt 0 ]; then
    printf '\n'
    die "$fails check(s) failed. Restore the contract, or waive a check on the record with --allow <check>=<reason>."
  fi
  [ ${#cmd[@]} -gt 0 ] || return 0

  lock=$(bench_lock_path)
  mkdir -p "$(dirname "$lock")"
  acquire_bench_lock "$lock"
  # shellcheck disable=SC2064 # expand now: $lock is local and gone when the EXIT trap fires
  trap "rm -rf $(printf %q "$lock")" EXIT
  trap 'exit 130' INT TERM
  printf '\n'
  say "running under the benchmark lock: ${cmd[*]}"
  "${cmd[@]}"
}

main() {
  local cmd=${1:-help}
  if [ $# -gt 0 ]; then shift; fi
  case $cmd in
    doctor) cmd_doctor "$@" ;;
    setup) cmd_setup "$@" ;;
    run) cmd_run "$@" ;;
    sanitize) cmd_sanitize "$@" ;;
    valgrind) cmd_valgrind "$@" ;;
    fuzz) cmd_fuzz "$@" ;;
    bench-guard) cmd_bench_guard "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
